/** Misc. example code, not deployed with a release. */
object examples extends OpenHtmlModule {
  def openHtmlArtifactName = "openhtmltopdf-examples"
  def openHtmlDescription = "Misc. Open HTML to PDF example code. It is not deployed with a release."
  def moduleDeps = Seq(core, pdfbox, rtlSupport, svgSupport, mathmlSupport, java2d, objects, latexSupport)
  def mvnDeps = Seq(
    mvn"org.mozilla:rhino:$rhinoVersion",
    mvn"org.jfree:jfreechart:1.5.0",
    mvn"com.google.zxing:javase:3.4.0",
    mvn"org.freemarker:freemarker:2.3.27-incubating",
    mvn"org.openjdk.jmh:jmh-core:$jmhVersion",
    mvn"org.openjdk.jmh:jmh-generator-annprocess:$jmhVersion"
  )

  object test extends OpenHtmlTests, TestModule.Junit4 {
    def junit4Version = junitVersion
    def mvnDeps = Seq(mvn"org.jsoup:jsoup:1.23.2")
  }
}

/** The JMH benchmark harness, replacing the shaded `benchmarks.jar` of the Maven build. */
object benchmarks extends JavaModule {
  def moduleDeps = Seq(examples)
  def sources = Task.Sources()
  def resources = Task.Sources()
  def mainClass = Some("org.openjdk.jmh.Main")
}
